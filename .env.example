# PostgreSQL 18 Connection
POSTGRES_USER=myfin
POSTGRES_PASSWORD=myfin_secure_password
POSTGRES_DB=myfin
DATABASE_URL=postgresql://myfin:myfin_secure_password@localhost:5432/myfin?schema=public

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_32_bytes_base64_secret

# Field-Level Encryption Key (AES-256-GCM 32-byte hex)
ENCRYPTION_KEY=replace_with_64_character_hex_key
